
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
 id             String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products      Product[]
  employee      Employee?
  sessions      Session[]
  accounts      Account[]
  @@map("users")
}


model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                     String   @id

  accountId              String
  providerId             String

  issuer                 String

  userId                 String

  user                   User     @relation(fields: [userId],references: [id],onDelete: Cascade)

  accessToken            String?
  refreshToken           String?
  idToken                String?

  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?

  scope                  String?
  password               String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])

  @@unique([issuer, accountId])

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Employee {
  id              String      @id         @default(uuid())
  empCode         Int      @unique @default(autoincrement())
  
  fullName        String
  role            String
  
  department      String?
  territory       String?
  
  mobile          String
  email           String?     
  
  pan             String?     
  aadhar          String?     
  
  bankAccNo       String?
  IFSC            String?
  
  salary          Decimal?     @db.Decimal(12, 2)

  isActive        Boolean     @default(true)
  userId          String?     @unique
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  joinDate        DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([empCode])
  @@index([email])
  @@index([role])
  @@index([department])
  @@index([territory])
  @@map("employees")
}

enum ProductType {
  FINISHED_GOOD
  RAW_MATERIAL
  PACKAGING_MATERIAL
  SEMI_FINISHED_GOOD
}

enum ProductForm {
  POWDER
  WHOLE
  CRUSHED
  GRANULES
  PASTE
  LIQUID
  OTHER
}

enum VegNonVeg {
  VEG
  NON_VEG
}

model Product {
  id          String          @id         @default(cuid())
  code        String          @unique
  barcode     String?         @unique
  name        String
  commonName  String?
  botanicalName String?
  brand         String?
  category    String
  type        ProductType     @default(FINISHED_GOOD)
  grade       String?
  form        ProductForm?

  hsn         String?
  unit        String

  packagingType  String?
  packSize     String?
  netWeight   String?

  shelfLife Int?

  processingMethod String?
  rawMaterialSource String?
  plantId String?

  moistureContent Decimal? @db.Decimal(5, 2)
  purityTest String?
  adulterationTest String?
  pesticideTestRef String?

  ingredients String? @db.Text
  allergenInfo String? @db.Text
  storageInstructions String? @db.Text
  vegNonVeg VegNonVeg @default(VEG)
  countryOfOrigin String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  batches ProductBatch[]
  prices ProductPrice[]
  inventories Inventory[]
  certifications ProductCertification[]
  productManufacturer ProductManufacturer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@index([category])
  @@index([brand])
  @@map("products")
}

model ProductBatch {
  id String @id @default(uuid())

  productId String
  product Product @relation(fields: [productId],references: [id],onDelete: Cascade)

  batchNo String
  productionDate DateTime?
  mfgDate DateTime?
  expiryDate DateTime?
  bestBefore String?

  plantId String?
  processingMethod String?

  moistureContent Decimal? @db.Decimal(5, 2)
  purityTest String?
  adulterationTest String?
  pesticideTestRef String?

  inventories Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productId, batchNo])
  @@index([batchNo])
  @@index([expiryDate])
  @@map("product_batches")
}

model ProductPrice {
  id String @id @default(uuid())

  productId String
  product Product @relation(fields: [productId], references: [id],onDelete: Cascade)

  mrp Decimal? @db.Decimal(12, 2)
  distributorPrice Decimal? @db.Decimal(12, 2)
  retailerPrice Decimal? @db.Decimal(12, 2)
  dealerPrice Decimal? @db.Decimal(12, 2)
  purchaseCost Decimal? @db.Decimal(12, 2)
  manufacturingCost Decimal? @db.Decimal(12, 2)
  gst Decimal? @db.Decimal(5, 2)
  discountScheme String?
  effectiveFrom DateTime @default(now())
  effectiveTo DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_prices")
}

model Inventory {
  id String @id @default(uuid())

  productId String
  product Product @relation(fields: [productId],references: [id],onDelete: Cascade)

  batchId String?

  batch ProductBatch? @relation( fields: [batchId],references: [id])
  warehouseLocation String
  currentStock Decimal @default(0) @db.Decimal(14, 3)
  reorderLevel Decimal? @db.Decimal(14, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([batchId])
  @@index([warehouseLocation])
  @@map("inventory")
}

model Manufacturer {
  id String @id @default(uuid())
  name String
  fssaiLicense String?
  address String?
  countryOfOrigin String?
  customerCarePhone String?
  customerCareEmail String?

  products ProductManufacturer[]
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
  @@map("manufacturers")
}

model ProductManufacturer {
  id String @id @default(uuid())

  productId String
  manufacturerId String
  product Product @relation(fields: [productId],references: [id],onDelete: Cascade)
  manufacturer Manufacturer @relation(fields: [manufacturerId],references: [id],onDelete: Cascade)

  @@unique([productId, manufacturerId])
  @@map("product_manufacturers")
}

model ProductCertification {
  id String @id @default(uuid())

  productId String
  product Product @relation(fields: [productId],references: [id],onDelete: Cascade)

  name String
  certificateNumber String?
  issuedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_certifications")
}

model Profile {
  id             String                     @id                            @default(uuid())
  companyName    String                     
  GSTIN          String
  pan            String?
  fssai          String?
  mobile         String?
  email          String?
  website        String?
  address        String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum BankType {
  SAVINGS
  CURRENT
}

model BankDetails {
  id            String                     @id                            @default(uuid())
  bankName      String 
  accountNumber BigInt
  ifsc          String
  accountType   BankType                    @default(CURRENT)
  upiId         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model BillingSettings {
  id             String                     @id                            @default(uuid())
  invPrefix      String                     @default("INV")
  finYearStart   DateTime
  paymentTerms   Int?                        @default(30)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

