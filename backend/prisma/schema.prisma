generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  products Product[]
  employee Employee?
  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id String @id

  accountId  String
  providerId String

  issuer String

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken  String?
  refreshToken String?
  idToken      String?

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?

  scope    String?
  password String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Employee {
  id      String @id @default(uuid())
  empCode Int    @unique @default(autoincrement())

  fullName String
  role     String

  department String?
  territory  String?

  mobile String
  email  String?

  pan    String?
  aadhar String?

  bankAccNo String?
  IFSC      String?

  salary Decimal? @db.Decimal(12, 2)

  isActive Boolean @default(true)
  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  assignedCustomers Customer[]
  saleOrders SaleOrder[]

  joinDate  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([empCode])
  @@index([email])
  @@index([role])
  @@index([department])
  @@index([territory])
  @@map("employees")
}

enum ProductType {
  FINISHED_GOOD
  RAW_MATERIAL
  PACKAGING_MATERIAL
  SEMI_FINISHED_GOOD
}

enum ProductForm {
  POWDER
  WHOLE
  CRUSHED
  GRANULES
  PASTE
  LIQUID
  OTHER
}

enum VegNonVeg {
  VEG
  NON_VEG
}

model Product {
  id            String       @id @default(cuid())
  code          String       @unique
  barcode       String?      @unique
  name          String
  commonName    String?
  botanicalName String?
  brand         String?
  category      String
  type          ProductType  @default(FINISHED_GOOD)
  grade         String?
  form          ProductForm?

  hsn  String?
  unit String

  packagingType String?
  packSize      String?
  netWeight     String?

  shelfLife Int?

  processingMethod  String?
  rawMaterialSource String?
  plantId           String?

  moistureContent  Decimal? @db.Decimal(5, 2)
  purityTest       String?
  adulterationTest String?
  pesticideTestRef String?

  ingredients         String?   @db.Text
  allergenInfo        String?   @db.Text
  storageInstructions String?   @db.Text
  vegNonVeg           VegNonVeg @default(VEG)
  countryOfOrigin     String?

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  batches             ProductBatch[]
  prices              ProductPrice[]
  inventories         Inventory[]
  certifications      ProductCertification[]
  productManufacturer ProductManufacturer[]
  saleOrderItems      SaleOrderItems[]
  invoiceItems        InvoiceItems?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([name])
  @@index([category])
  @@index([brand])
  @@map("products")
}

model ProductBatch {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  batchNo        String
  productionDate DateTime?
  mfgDate        DateTime?
  expiryDate     DateTime?
  bestBefore     String?

  plantId          String?
  processingMethod String?

  moistureContent  Decimal? @db.Decimal(5, 2)
  purityTest       String?
  adulterationTest String?
  pesticideTestRef String?

  inventories Inventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, batchNo])
  @@index([batchNo])
  @@index([expiryDate])
  @@map("product_batches")
}

model ProductPrice {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  mrp               Decimal?  @db.Decimal(12, 2)
  distributorPrice  Decimal?  @db.Decimal(12, 2)
  retailerPrice     Decimal?  @db.Decimal(12, 2)
  dealerPrice       Decimal?  @db.Decimal(12, 2)
  purchaseCost      Decimal?  @db.Decimal(12, 2)
  manufacturingCost Decimal?  @db.Decimal(12, 2)
  gst               Decimal?  @db.Decimal(5, 2)
  discountScheme    String?
  effectiveFrom     DateTime  @default(now())
  effectiveTo       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_prices")
}

model Inventory {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  batchId String?

  batch             ProductBatch? @relation(fields: [batchId], references: [id])
  warehouseLocation String
  currentStock      Decimal       @default(0) @db.Decimal(14, 3)
  reorderLevel      Decimal?      @db.Decimal(14, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([batchId])
  @@index([warehouseLocation])
  @@map("inventory")
}

model Manufacturer {
  id                String  @id @default(uuid())
  name              String
  fssaiLicense      String?
  address           String?
  countryOfOrigin   String?
  customerCarePhone String?
  customerCareEmail String?

  products  ProductManufacturer[]
  createdAt DateTime              @default(now())

  updatedAt DateTime @updatedAt

  @@map("manufacturers")
}

model ProductManufacturer {
  id String @id @default(uuid())

  productId      String
  manufacturerId String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)

  @@unique([productId, manufacturerId])
  @@map("product_manufacturers")
}

model ProductCertification {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name              String
  certificateNumber String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([productId])
  @@map("product_certifications")
}

model Profile {
  id          String  @id @default(uuid())
  companyName String
  GSTIN       String
  pan         String?
  fssai       String?
  mobile      String?
  email       String?
  website     String?
  address     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BankType {
  SAVINGS
  CURRENT
}

model BankDetails {
  id            String   @id @default(uuid())
  bankName      String
  accountNumber String
  ifsc          String
  accountType   BankType @default(CURRENT)
  upiId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BillingSettings {
  id           String   @id @default(uuid())
  invPrefix    String   @default("INV")
  finYearStart DateTime
  paymentTerms Int?     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CustomerType {
  DISTRIBUTOR
  SUPER_STOCKIST
  RETAILER
  WHOLESALER
  MODERN_TRADE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id           String @id @default(uuid())
  customerCode Int    @unique @default(autoincrement())

  shopName  String
  ownerName String
  type      CustomerType
  gstNumber String?        @unique
  pan       String?        @unique
  fssai     String?
  status    CustomerStatus @default(ACTIVE)

  mobile   String
  whatsapp String?
  email    String?

  street    String?
  state     String?
  stateCode String?
  district  String?
  pincode   String?
  latitude  String?
  longitude String?

  salesTerritory     String?
  assignedSalesmanId String? 
  assignedSalesman   Employee? @relation(fields: [assignedSalesmanId],references: [id])

  saleOrders SaleOrder[]
  invoices   Invoice[]

  creditLimit  Decimal @default(0)
  paymentTerms Int     @default(0)
  openingBal   Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gstNumber])
  @@index([pan])
}

// SALE ORDERS

enum SaleOrderStatus {
  PENDING
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

model SaleOrderItems {
  id          String  @id @default(uuid())
  gst         Decimal
  price       Decimal
  productId   String
  productName String
  qty         Decimal
  total       Decimal

  saleOrderId String
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleOrder {
  id            String @id @default(uuid())
  saleOrderCode Int    @unique @default(autoincrement())

  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])

  customerName String?
  items        SaleOrderItems[]
  date         DateTime         @default(now())
  subtotal     Decimal
  gstAmount    Decimal
  total        Decimal
  status       SaleOrderStatus  @default(PENDING)

  salesmanId    String
  salesman      Employee @relation(fields: [salesmanId], references: [id])

  isActive     Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleOrderCode])
  @@index([customerName])
}


model NumberSequence {
  id            String      @id   @default(cuid())
  key           String      @unique
  invoices      Invoice[]
  current       Int         @default(0)
  updatedAt     DateTime    @updatedAt
}

enum InvoiceLabel {
  TAX_INVOICE
  DELIVERY_CHALLAN
  PROFORMA_INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum SupplyType {
  TAXABLE
  EXEMPT
  EXPORT
  SEZ
  NON_GST
}

enum TransportMode {
  ROAD
  RAIL
  AIR
  SHIP
  COURIER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  VOID
}

model InvoiceItems {
  id            String @id  @default(cuid())
  productId     String @unique
  product       Product @relation(fields: [productId], references: [id])
  hsn           String
  qty           Decimal
  rate          Decimal
  discPer       Decimal
  gstPer        Decimal
  amount        Decimal

  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([invoiceId])
  @@index([productId])
}

model Invoice {
   id            String @id @default(cuid())
   label         InvoiceLabel

   sequenceId    String
   sequence      NumberSequence @relation(fields: [sequenceId], references: [id])

   docNo         String @unique
   customerId    String
   customer      Customer @relation(fields: [customerId], references: [id])
   docDate       DateTime @default(now())
   dueDate       DateTime
   paymentTerms  String?
   supplyType    SupplyType 
   placeOfSupply String?
   reverseCharge Boolean?
   transportMode TransportMode?
   vehicleNo     String?
   ewayNo        String?
   deliveryDate  DateTime?
   notes         String?
   terms         String?

   items         InvoiceItems[]

   subTotal      Decimal
   discount      Decimal?
   roundOff      Decimal?
   taxable       Decimal
   igst          Decimal
   sgst          Decimal
   cgst          Decimal

   billingAddress String
   shippingAddress String

   grandTotal    Decimal

   status        InvoiceStatus @default(DRAFT)

   createdAt     DateTime @default(now())
   updatedAt     DateTime @updatedAt

   @@index([customerId])
   @@index([sequenceId])
   @@index([docDate])
}